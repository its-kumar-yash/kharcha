# Copy to .env and fill in. Never commit .env.
TINKER_API_KEY=
BACKBOARD_API_KEY=
# Set after training: printed by train/sft_tinker.py
KHARCHA_SAMPLER_PATH=
# ollama (laptop, private) | tinker (hosted demo on Render)
PARSER_BACKEND=ollama
OLLAMA_MODEL=kharcha
# Backboard model routing for the Ask box (open-weight via OpenRouter)
BACKBOARD_LLM_PROVIDER=openrouter
BACKBOARD_MODEL_NAME=qwen/qwen3-32b
